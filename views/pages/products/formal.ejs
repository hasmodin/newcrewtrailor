<%- layout('layouts/boilerplate') %>
<main class="product-page">
  <section class="product-hero">
    <h1>Formal & Custom Wear</h1>
    <p>Premium craftsmanship for professional and lifestyle standards.</p>
  </section>

  <div class="product-container">
    <div class="product-grid">
      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-suit.jpg" alt="Bespoke Suits" />
          <div class="product-badge">Custom Tailored</div>
        </div>
        <div class="product-info">
          <h3>Premium Suits</h3>
          <p>
            Crafted with precision and high-grade fabrics for a perfect fit.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-blazer.jpg" alt="Blazers" />
          <div class="product-badge">Custom Blazer</div>
        </div>
        <div class="product-info">
          <h3>Blazers & Coats</h3>
          <p>Sophisticated designs for corporate and formal events.</p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-thobe.jpg" alt="Thobes" />
          <div class="product-badge">Traditional</div>
        </div>
        <div class="product-info">
          <h3>Traditional Thobes</h3>
          <p>Elegant traditional wear with modern stitching standards.</p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-info">
          <h3>Other Formal Essentials</h3>
          <ul class="formal-list">
            <li>Trousers & Skirts</li>
            <li>Waistcoats / Vest Coats</li>
            <li>Formal Shirts & Blouses</li>
          </ul>
          <a href="/contact" class="inquiry-btn">Inquire for Bulk</a>
        </div>
      </div>
    </div>
  </div>
</main>
