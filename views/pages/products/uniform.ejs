<%- layout('layouts/boilerplate') %>

<main class="product-page">
  <section class="uniform-hero">
    <div class="container">
      <h1>Uniforms & Workwear</h1>
      <p>Durable, comfortable, and professional apparel for every industry.</p>
    </div>
  </section>

  <div class="product-container">
    <div class="product-grid">
      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-uniform.jpg" alt="Industrial Coveralls" />
          <div class="product-badge">Industrial</div>
        </div>
        <div class="product-info">
          <h3>Heavy Duty Coveralls</h3>
          <p>
            High-visibility and protective gear designed for safety and
            durability.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-polo-tshirt.jpg"" alt="Polo T-Shirts" />
          <div class="product-badge">Retail</div>
        </div>
        <div class="product-info">
          <h3>Polo T-Shirts</h3>
          <p>
            Premium cotton-blend polos, perfect for staff uniforms and branding.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/products-apron.jpg" alt="Tabards & Aprons" />
          <div class="product-badge">Hospitality</div>
        </div>
        <div class="product-info">
          <h3>Tabards & Aprons</h3>
          <p>
            Functional and stylish wear for the hospitality and service sectors.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-info">
          <h3>Additional Workwear</h3>
          <ul class="formal-list">
            <li>Company Sweaters</li>
            <li>Workwear Trousers</li>
            <li>High-Vis Jackets</li>
            <li>Security Uniforms</li>
          </ul>
          <a href="/contact" class="inquiry-btn">Request Bulk Quote</a>
        </div>
      </div>
    </div>
  </div>

  <section class="industry-serve">
    <div class="container">
      <h2 style="color: white">Industries We Serve</h2>
      <div class="industry-grid">
        <div class="industry-item">Hospitality</div>
        <div class="industry-item">Industrial</div>
        <div class="industry-item">Corporate</div>
        <div class="industry-item">Retail</div>
      </div>
    </div>
  </section>
</main>
