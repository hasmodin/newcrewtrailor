<%- layout('layouts/boilerplate') %>

<main class="product-page">
  <section class="accessories-hero">
    <div class="container">
      <h1>Premium Accessories</h1>
      <p>The perfect finishing touches for the modern professional.</p>
    </div>
  </section>

  <div class="product-container">
    <div class="product-grid">
      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/accessoris-tie.jpg" alt="Silk Ties" />
          <div class="product-badge">100% Silk</div>
        </div>
        <div class="product-info">
          <h3>Silk Ties & Bowties</h3>
          <p>
            Available in a variety of patterns and colors to match your custom
            suits.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/accessories-belt.jpg" alt="Leather Belts" />
          <div class="product-badge">Leather</div>
        </div>
        <div class="product-info">
          <h3>Leather Belts</h3>
          <p>
            Genuine leather accessories with premium buckles for durability and
            style.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-img-wrapper">
          <img src="/uploads/accessories-cufflinks.jpg" alt="Cufflinks" />
          <div class="product-badge">Elegant</div>
        </div>
        <div class="product-info">
          <h3>Cufflinks & Clips</h3>
          <p>
            Detailed metalware to add a touch of class to your formal shirts.
          </p>
        </div>
      </div>

      <div class="product-card">
        <div class="product-info">
          <h3>Other Essentials</h3>
          <ul class="formal-list">
            <li>Pocket Squares</li>
            <li>Socks & Hosiery</li>
            <li>Tie Pins</li>
            <li>Wallet & Card Holders</li>
          </ul>
          <a href="/contact" class="inquiry-btn">Inquire for Gift Sets</a>
        </div>
      </div>
    </div>
  </div>
</main>
