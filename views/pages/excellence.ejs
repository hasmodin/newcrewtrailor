<%- layout("layouts/boilerplate") %>

<main class="excellence-page">
  <header class="excellence-header">
    <div class="container">
      <h1>Manufacturing Excellence</h1>
      <p>Where precision meets premium craftsmanship.</p>
    </div>
  </header>

  <section class="process-grid">
    <div class="container">
      <div class="process-content">
        <h2>Our Multi-Tier Quality Control</h2>
        <p>
          At New Crew Tailor, quality isn't just a final check—it's integrated
          into every stage of production. Backed by extensive garment industry
          knowledge, our workforce ensures strict quality control procedures.
        </p>

        <div class="step">
          <div class="step-num">01</div>
          <div class="step-text">
            <h3>Premium Fabric Sourcing</h3>
            <p>
              We select only high-grade materials that ensure durability,
              comfort, and a professional look.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">02</div>
          <div class="step-text">
            <h3>Precision Cutting & Stitching</h3>
            <p>
              Our skilled tailors use modern techniques to ensure perfect fit
              and structural integrity.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">03</div>
          <div class="step-text">
            <h3>Detailed Finishing</h3>
            <p>
              From seam alignment to button security, we focus on the details
              that define luxury apparel.
            </p>
          </div>
        </div>
      </div>

      <div class="process-image">
        <img
          src="https://images.pexels.com/photos/6766301/pexels-photo-6766301.jpeg"
          alt="Detail of stitching"
        />
        <div class="experience-badge">
          <span>Expert</span>
          <p>Workforce</p>
        </div>
      </div>
    </div>
  </section>

  <section class="standards-banner" style="border-bottom: 1px solid #f2f2f2">
    <div class="container">
      <div class="standard-box">
        <h4>Durability</h4>
        <p>Built for the rigors of professional life.</p>
      </div>
      <div class="standard-box">
        <h4>Comfort</h4>
        <p>Ergonomic designs for daily wear.</p>
      </div>
      <div class="standard-box">
        <h4>Style</h4>
        <p>Modern aesthetics tailored to your brand.</p>
      </div>
    </div>
  </section>
</main>
