<%- layout("layouts/boilerplate") %>
<main class="contact-page">
  <section class="contact-hero">
    <h1>Get In Touch</h1>
    <p>Partner with us for reliable and high-quality apparel solutions.</p>
  </section>

  <div class="contact-container">
    <div class="contact-form-section">
      <h2>Send us a Message</h2>
      <form action="/contact" method="POST">
        <div class="form-group">
          <input type="text" name="name" placeholder="Your Name" required />
        </div>
        <div class="form-group">
          <input type="email" name="email" placeholder="Your Email" required />
        </div>
        <div class="form-group">
          <select name="service">
            <option value="formal">Formal & Custom Wear</option>
            <option value="uniforms">Uniforms & Workwear</option>
            <option value="accessories">Accessories</option>
            <option value="other">Other Inquiry</option>
          </select>
        </div>
        <div class="form-group">
          <textarea
            name="message"
            rows="5"
            placeholder="Tell us about your requirements..."
            required
          ></textarea>
        </div>
        <button type="submit" class="submit-btn">Send Message</button>
      </form>
    </div>

    <div class="contact-info-section">
      <h2>Our Office</h2>
      <div class="info-card">
        <div class="info-item">
          <span class="icon">📍</span>
          <p>Zone 26 Street 320 building 67<br />Doha, Qatar</p>
        </div>
        <div class="info-item">
          <span class="icon">📞</span>
          <p>55066593 / 33099794</p>
        </div>
        <div class="info-item">
          <span class="icon">✉️</span>
          <p>info@newcrewtailor.com</p>
        </div>
      </div>

      <div class="hours-section">
        <h4>Business Hours</h4>
        <p>Saturday - Thursday: 8:00 AM - 8:00 PM</p>
        <p>Friday: Closed</p>
      </div>
    </div>
  </div>
</main>
