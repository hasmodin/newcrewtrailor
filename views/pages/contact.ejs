<%- layout("layouts/boilerplate") %>
<main class="contact-page">
  <section class="contact-hero">
    <h1>Get In Touch</h1>
    <p>Partner with us for reliable and high-quality apparel solutions.</p>
  </section>

  <div class="contact-container">
    <div class="contact-form-section">
      <h2>Send us a Message</h2>
      <form action="/contact" method="POST">
        <div class="form-group">
          <input type="text" name="name" placeholder="Your Name" required />
        </div>
        <div class="form-group">
          <input type="email" name="email" placeholder="Your Email" required />
        </div>
        <div class="form-group">
          <select name="service">
            <option value="formal">Formal & Custom Wear</option>
            <option value="uniforms">Uniforms & Workwear</option>
            <option value="accessories">Accessories</option>
            <option value="other">Other Inquiry</option>
          </select>
        </div>
        <div class="form-group">
          <textarea
            name="message"
            rows="5"
            placeholder="Tell us about your requirements..."
            required
          ></textarea>
        </div>
        <button type="submit" class="submit-btn">Send Message</button>
      </form>
    </div>

    <div class="contact-info-section">
      <h2>Our Office</h2>
      <div class="info-card">
        <div class="info-item">
          <span class="icon">📍</span>
          <p>Zone 26 Street 320 building 67<br />Doha, Qatar</p>
        </div>
        <div class="info-item">
          <span class="icon">📞</span>
          <p>+974-55066593 / +974-33099794</p>
        </div>
        <div class="info-item">
          <span class="icon">✉️</span>

          <a
            href="mailto:newcrewtailor.com@newcrewtailor.com"
            style="text-decoration: none; color: #f2f2f2"
            >info@newcrewtailor.com</a
          >
        </div>
      </div>

      <div class="hours-section">
        <h4>Business Hours :</h4>
        <p>Saturday - Thursday: 9:00 AM-1:00 PM, 4:00-11:00 PM</p>
        <p>Friday: 4:00-11:00 PM</p>
      </div>
    </div>
  </div>
  <div style="margin-top: 1rem; margin-bottom: -80px">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d902.0174061561643!2d51.53704240136723!3d25.268243199999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e45c5e417eeca67%3A0x56b97acc3c5f354f!2sNew%20Crew%20Tailor!5e0!3m2!1sen!2sqa!4v1787292929137!5m2!1sen!2sqa"
      width="100%"
      height="450"
      style="border: 0"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
</main>
