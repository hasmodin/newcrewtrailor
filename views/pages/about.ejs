<%- layout("layouts/boilerplate") %>

<main class="vision-page">
  <section class="vision-hero">
    <div class="hero-overlay">
      <h1>Our Vision & Mission</h1>
      <p>Crafting excellence, delivering reliability.</p>
    </div>
  </section>

  <section class="core-values">
    <div class="container">
      <div class="value-card vision">
        <div class="icon">👁️</div>
        <h2>Our Vision</h2>
        <p>
          To become a trusted global apparel partner known for quality,
          innovation, and reliability.
        </p>
      </div>

      <div class="value-card mission">
        <div class="icon">🎯</div>
        <h2>Our Mission</h2>
        <ul>
          <li>Manufacture garments that exceed customer expectations.</li>
          <li>Utilize premium fabrics and skilled craftsmanship.</li>
          <li>Deliver consistent quality with timely production.</li>
          <li>Build long-term partnerships through performance.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="excellence-section">
    <div class="excellence-content">
      <h2>Manufacturing Excellence</h2>
      <p>
        At New Crew Tailor, we maintain a
        <strong>multi-tier quality control system</strong>. Backed by
        experienced personnel, we ensure strict quality at every stage of
        production—from fabric selection to the final stitch.
      </p>
      <div class="stats-grid">
        <div class="stat-item">
          <span>100%</span>
          <p>Quality Inspected</p>
        </div>
        <div class="stat-item">
          <span>2026</span>
          <p>Established Vision</p>
        </div>
        <div class="stat-item">
          <span>Premium</span>
          <p>Fabric Sourcing</p>
        </div>
      </div>
    </div>
  </section>
</main>
