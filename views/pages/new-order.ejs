  function applyStandardSizes() {
    const gender = document.getElementById("genderSelect").value;
    const country = document.getElementById("countrySelect").value;
    const size = document.getElementById("sizeSelect").value;

    if (!size || !sizeCharts[gender]?.[country]?.[size]) return;

    const data = sizeCharts[gender][country][size];

    // Set Top Fields
    const chestInput = document.querySelector(
      'input[name="measurements[top][chest]"]',
    );
    const shoulderInput = document.querySelector(
      'input[name="measurements[top][shoulder]"]',
    );
    const topLengthInput = document.querySelector(
      'input[name="measurements[top][length]"]',
    );

    // Set Bottom Fields
    const waistInput = document.querySelector(
      'input[name="measurements[bottom][waist]"]',
    );
    const hipInput = document.querySelector(
      'input[name="measurements[bottom][hip]"]',
    );
    const bottomLengthInput = document.querySelector(
      'input[name="measurements[bottom][length]"]',
    );

    if (chestInput) chestInput.value = data.chest;
    if (shoulderInput) shoulderInput.value = data.shoulder;
    if (topLengthInput) topLengthInput.value = data.topLength;
    if (waistInput) waistInput.value = data.waist;
    if (hipInput) hipInput.value = data.hip;
    if (bottomLengthInput) bottomLengthInput.value = data.trouserLength;
  }
