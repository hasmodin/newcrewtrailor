<%- layout("layouts/boilerplate") %>

<section class="hero">
  <div class="hero-content">
    <div class="logo-name">
      <h1 >New</h1>
      <h1 class="c">Crew</h1>
      <h1 class="t">Tailor</h1>
    </div>
  

    <p>Dedicated apparel manufacturer & supplier since 2025.</p>
    <a href="/contact" class="btn-primary">Get a Quote</a>
  </div>
</section>

<section class="intro hero-container">
  <h2>Hi There!</h2>
  <p>
    We focus on quality craftsmanship, premium fabrics, and reliable supply
    tailored to meet your professional needs. Whether you need ready-made
    garments or custom-designed solutions, we are here to deliver.
  </p>
</section>

<section class="services hero-container">
  <div class="service-card">
    <div class="service-img-wrapper">
      <img src="/uploads/products-suit.jpeg" alt="formal & custom wear" />
    </div>
    <h3 style="padding: 10px;">Formal & Custom Wear</h3>
    <p style="padding: 8px 10px;">Suits, Blazers, and Thobes crafted with precision.</p>
  </div>
  <div class="service-card">
    <div class="service-img-wrapper">
      <img src="/uploads/products-uniform.jpeg" alt="formal & custom wear" />
    </div>
    
    <h3 style="padding: 10px;">Uniforms & Workwear.</h3>
    <p style="padding: 8px 10px;">Professional coveralls, tabards, and polo shirts for your team.</p>
  </div>
  <div class="service-card">
    <div class="service-img-wrapper" />
    <img src="/uploads/accessories-cufflinks.jpg" alt="formal & custom wear" />
    </div>
    
    <h3 style="padding: 10px;">Accessories</h3>
    <p style="padding: 8px 10px;">The finishing touches: Ties, cufflinks, and belts.</p>
  </div>
</section>

